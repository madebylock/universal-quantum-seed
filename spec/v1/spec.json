{
  "spec_version": "1.0",
  "name": "Universal Quantum Seed",
  "domain_separator": "universal-seed-v1",
  "compatibility_contract": "v1 seeds MUST always derive the same outputs forever. No parameter may be changed within v1.",

  "seed": {
    "word_counts": [24, 36],
    "entropy_bytes": {"24": 22, "36": 34},
    "checksum_bits": {"24": 14, "36": 12},
    "packed_bits": {"24": 190, "36": 284},
    "entropy_bits": {"24": 176, "36": 272},
    "post_quantum_bits": {"24": 88, "36": 136},
    "quantum_safe_minimum": 36,
    "icon_set_size": 256,
    "icon_index_range": [0, 255],
    "bits_per_icon": 8,
    "distinct_icons": true,
    "encoding": {
      "name": "falling-factorial mixed-radix unrank (permutation without replacement of the 256-icon table)",
      "packed_value": "V = (int_be(entropy) << checksum_bits) | checksum",
      "encode": "unused = [0..255]; for position i in 0..N-1: digit = V mod (256-i); V = V div (256-i); icon_i = unused.pop(digit). Position 0 takes the least-significant digit; position N-1 the most-significant.",
      "decode": "digit_i = index of icon_i in the still-unused list (then remove it); V = Horner from position N-1 down to 0: V = V*(256-pos) + digit_pos; checksum = V & (2^checksum_bits - 1); entropy = (V >> checksum_bits) as entropy_bytes big-endian.",
      "reject": [
        "length not 24 or 36",
        "element not an integer in 0..255",
        "repeated icon (structural, checked before the checksum)",
        "(V >> checksum_bits) >= 2^(8*entropy_bytes) (unrank headroom, never produced by encoding)",
        "checksum mismatch"
      ],
      "capacity_check": "2^(8*entropy_bytes + checksum_bits) <= 256!/(256-N)!  (284 <= 284.27 bits for 36 words, 190 <= 190.39 for 24)",
      "cutover": "Replaces v1 in place (UQS was never officially released). Pre-release 'N-2 data words + 2 checksum words' phrases are not valid v1 phrases; there is no legacy decode path. Master seeds for a given entropy are unchanged.",
      "per_position_note": "The phrase as a whole carries exactly 8*entropy_bytes bits, but per-position marginals are not uniform: the last icon is strongly biased because its digit only partly spans its radix. Inherent to mixed-radix encoding; not an RNG defect."
    }
  },

  "checksum": {
    "algorithm": "HMAC-SHA-256",
    "key": "universal-seed-v1-checksum",
    "key_bytes": 26,
    "message": "the entropy bytes (22 for 24 words, 34 for 36 words), not the icon indexes",
    "output": "top checksum_bits of int_be(digest[0:2]): int_be(digest[0:2]) >> (16 - checksum_bits)",
    "checksum_bits": {"24": 14, "36": 12},
    "error_detection_bits": {"24": 14, "36": 12},
    "false_positive_rate": {"24": "1 in 16384", "36": "1 in 4096"},
    "placement": "the low checksum_bits of the packed value V; no separate checksum words"
  },

  "passphrase": {
    "encoding": "UTF-8",
    "normalization": "NFKC",
    "trimming": false,
    "case_folding": false,
    "empty_equals_none": true
  },

  "kdf_pipeline": {
    "stages": [
      {
        "stage": 0,
        "name": "Phrase Decoding & Checksum Verification",
        "description": "Rank the N distinct icon indexes to the packed value V (reject a wrong length, an out-of-range element, a repeated icon, or (V >> checksum_bits) >= 2^(8*entropy_bytes)); split V into entropy bytes and checksum; recompute the truncated HMAC-SHA-256 over the entropy bytes and reject on mismatch. Only the recovered entropy bytes continue to stage 1."
      },
      {
        "stage": 1,
        "name": "Length-Prefixed Payload",
        "description": "Build a versioned, domain-separated payload with explicit length prefixes on every variable-length field. Layout: b'universal-seed-v1-seed-payload-v1' || uint16_LE(entropy_bytes: 22 or 34) || (pos, entropy_byte) pairs || b'\\x01passphrase' || uint32_LE(passphrase_byte_len) || NFKC(passphrase) bytes. The domain prefix, entropy-length prefix, field tag, and passphrase length prefix together ensure that no two distinct (entropy, passphrase) inputs share a payload."
      },
      {
        "stage": 2,
        "name": "HKDF-Extract",
        "algorithm": "HMAC-SHA-512",
        "key": "universal-seed-v1",
        "key_bytes": 17,
        "message": "length-prefixed payload from stage 1",
        "output_bytes": 64
      },
      {
        "stage": 3,
        "name": "Chained KDF Stretching",
        "substages": [
          {
            "name": "PBKDF2-SHA-512",
            "salt": "universal-seed-v1-stretch-pbkdf2",
            "salt_bytes": 32,
            "rounds": 600000,
            "dklen": 64
          },
          {
            "name": "Argon2id",
            "salt": "universal-seed-v1-stretch-argon2id",
            "salt_bytes": 34,
            "time_cost": 3,
            "memory_cost_kib": 65536,
            "memory_cost_mib": 64,
            "parallelism": 4,
            "hash_len": 64,
            "type": "Argon2id"
          }
        ]
      },
      {
        "stage": 4,
        "name": "HKDF-Expand",
        "algorithm": "HMAC-SHA-512",
        "info": "universal-seed-v1-master",
        "info_bytes": 24,
        "output_bytes": 64
      }
    ],
    "output": {
      "total_bytes": 64,
      "encryption_key": "first 32 bytes",
      "authentication_key": "last 32 bytes"
    }
  },

  "profiles": {
    "algorithm": "HMAC-SHA-512",
    "key": "master seed (64 bytes)",
    "message_prefix": "universal-seed-v1-profile",
    "message_prefix_bytes": 25,
    "output_bytes": 64,
    "empty_password": "returns master seed unchanged"
  },

  "fingerprint": {
    "length_hex": 8,
    "length_bytes": 4,
    "format": "uppercase hex",
    "derivation": "SHA-256(get_seed(words, passphrase))[0:4]",
    "note": "Always runs full KDF pipeline; callers should use background thread"
  },

  "crypto": {
    "post_quantum": {
      "ml-dsa-65": {
        "standard": "FIPS 204",
        "name": "ML-DSA-65 (Dilithium)",
        "type": "signature",
        "security_level": 3,
        "seed_size": 32,
        "public_key_size": 1952,
        "secret_key_size": 4032,
        "signature_size": 3309,
        "assumption": "Module Learning With Errors (MLWE)",
        "info_prefix": "universal-seed-v1-quantum-ml-dsa-65"
      },
      "slh-dsa-shake-128s": {
        "standard": "FIPS 205",
        "name": "SLH-DSA-SHAKE-128s (SPHINCS+)",
        "type": "signature",
        "security_level": 1,
        "seed_size": 48,
        "public_key_size": 32,
        "secret_key_size": 64,
        "signature_size": 7856,
        "assumption": "Hash-only (SHAKE-256)",
        "info_prefix": "universal-seed-v1-quantum-slh-dsa-shake-128s"
      },
      "ml-kem-768": {
        "standard": "FIPS 203",
        "name": "ML-KEM-768 (Kyber)",
        "type": "key_encapsulation",
        "security_level": 3,
        "seed_size": 64,
        "encapsulation_key_size": 1184,
        "decapsulation_key_size": 2400,
        "ciphertext_size": 1088,
        "shared_secret_size": 32,
        "assumption": "Module Learning With Errors (MLWE)",
        "implicit_rejection": true,
        "info_prefix": "universal-seed-v1-quantum-ml-kem-768"
      }
    },
    "classical": {
      "ed25519": {
        "standard": "RFC 8032",
        "name": "Ed25519",
        "type": "signature",
        "public_key_size": 32,
        "secret_key_size": 64,
        "signature_size": 64,
        "classical_security_bits": 128,
        "note": "Used as component of hybrid-dsa-65, not derived standalone"
      },
      "x25519": {
        "standard": "RFC 7748",
        "name": "X25519",
        "type": "key_exchange",
        "private_key_size": 32,
        "public_key_size": 32,
        "shared_secret_size": 32,
        "classical_security_bits": 128,
        "note": "Used as component of hybrid-kem-768, not derived standalone"
      }
    },
    "hybrid": {
      "hybrid-dsa-65": {
        "name": "Hybrid Ed25519 + ML-DSA-65",
        "type": "signature",
        "composition": "AND (both must verify)",
        "seed_size": 64,
        "public_key_size": 1984,
        "secret_key_size": 4096,
        "signature_size": 3373,
        "context_max_bytes": 255,
        "domain": "hybrid-dsa-v1",
        "stripping_resistance": true,
        "verify_after_sign": true,
        "info_prefix": "universal-seed-v1-quantum-hybrid-dsa-65",
        "components": {
          "classical": "Ed25519 (first 32B of seed)",
          "post_quantum": "ML-DSA-65 (last 32B of seed)"
        }
      },
      "hybrid-kem-768": {
        "name": "Hybrid X25519 + ML-KEM-768",
        "type": "key_encapsulation",
        "seed_size": 96,
        "encapsulation_key_size": 1216,
        "decapsulation_key_size": 2432,
        "ciphertext_size": 1120,
        "shared_secret_size": 32,
        "domain": "hybrid-kem-v1",
        "implicit_rejection": true,
        "info_prefix": "universal-seed-v1-quantum-hybrid-kem-768",
        "secret_combination": {
          "method": "HKDF-SHA256",
          "salt": "SHA-256(x25519_ct || ml_kem_ct)",
          "info": "hybrid-kem-v1 || SHA-256(x25519_pk || ml_kem_ek) || 0x01",
          "ciphertext_binding": true,
          "public_key_binding": true
        },
        "components": {
          "classical": "X25519 (first 32B of seed)",
          "post_quantum": "ML-KEM-768 (last 64B of seed as d||z)"
        }
      }
    },
    "derivation": {
      "method": "HKDF-Expand-SHA-512",
      "info_format": "<info_prefix> + key_index (4 bytes, little-endian uint32)"
    },
    "memory_hardening": {
      "backend": "libsodium (via PyNaCl, optional)",
      "features": ["sodium_mlock", "sodium_memzero", "sodium_munlock"],
      "fallback": "manual byte zeroing"
    }
  },

  "word_resolution": {
    "strict_mode": {
      "used_in": "key derivation",
      "normalization": "NFKC + lowercase",
      "emoji_variation_stripping": true,
      "fuzzy_fallbacks": false
    },
    "fuzzy_mode": {
      "used_in": "UI / recovery",
      "fallbacks": [
        "diacritic stripping (Latin, Greek, Arabic, Hebrew, Cyrillic)",
        "Arabic prefix stripping",
        "Hebrew prefix stripping",
        "French/Italian contraction stripping",
        "Scandinavian/Romanian/Icelandic suffix stripping"
      ]
    }
  }
}
